datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          String         // "SUPER_ADMIN", "PARTNER_MAIN", "PARTNER_SUB", "CLIENT_OWNER", "CLIENT_ADMIN", "CLIENT_STAFF"
  name          String
  phone         String?
  status        String         @default("ACTIVE") // "ACTIVE", "SUSPENDED"
  referralCode  String?
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  clientsOwned  Client[]       @relation("ClientOwner")
  teamAccess    TeamMember[]
  referrals     Referral[]
  payouts       Payout[]
  refreshTokens RefreshToken[]
  promotions    Promotion[]
  feedbacks     Feedback[]
}

model Client {
  id                 String       @id @default(uuid())
  name               String       // brandName
  ownerId            String
  plan               String       @default("NONE") // "NONE", "BASIC", "PRO", "ADVANCED"
  billingCycle       String       @default("monthly") // "monthly", "halfYear", "yearly"
  currentPeriodEnd   DateTime     @default(now())
  status             String       @default("ACTIVE") // "ACTIVE", "PAST_DUE", "CANCELLED"
  stripeCustomerId   String?
  stripeSubscriptionId String?
  aiName               String?      @default("AIVA Agent")
  aiPersona            String?      @default("Friendly")
  customPrompt         String?      @default("")
  notifyHotLead        Boolean?     @default(true)
  notifyDailyReport    Boolean?     @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  
  // Relations
  owner              User         @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teamMembers        TeamMember[]
  knowledgeEntries   Knowledge[]
  chats              Chat[]
  leads              Lead[]
  branches           Branch[]
  followUpRules      FollowUpRule[]
  feedbacks          Feedback[]
  integrations       Integration[]
}

model TeamMember {
  id        String   @id @default(uuid())
  clientId  String
  userId    String
  role      String   @default("STAFF") // "ADMIN", "STAFF"
  createdAt DateTime @default(now())
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([clientId, userId])
}

model Knowledge {
  id        String   @id @default(uuid())
  clientId  String
  type      String   // "FILE", "URL", "TEXT"
  title     String
  sourceUrl String?
  content   String
  fileSize  Int?     @default(0)
  tokens    Int      @default(0)
  status    String   @default("TRAINED") // "PENDING", "TRAINED", "FAILED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

model Chat {
  id              String    @id @default(uuid())
  clientId        String
  customerName    String
  customerContact String?
  platform        String    @default("WEB") // "LINE", "WEB", "FACEBOOK"
  status          String    @default("BOT_HANDLING") // "BOT_HANDLING", "ADMIN_HANDLING", "CLOSED"
  leadScore       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages        Message[]
  leads           Lead[]

  @@index([clientId])
  @@index([customerContact, platform])
  @@index([status])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  sender    String   // "BOT", "CUSTOMER", "AGENT"
  content   String
  createdAt DateTime @default(now())
  
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model Lead {
  id        String   @id @default(uuid())
  clientId  String
  chatId    String?
  name      String
  contact   String
  intent    String?
  value     Float    @default(0)
  stage     String   @default("NEW") // "NEW", "CONTACTED", "OFFER", "WON", "LOST"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chat      Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([chatId])
}

model Branch {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  managerName String
  status      String   @default("ACTIVE") // "ACTIVE", "INACTIVE"
  createdAt   DateTime @default(now())
  
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Referral {
  id        String   @id @default(uuid())
  partnerId String
  name      String   // Campaign Name
  code      String   @unique
  clicks    Int      @default(0)
  signups   Int      @default(0)
  createdAt DateTime @default(now())
  
  partner   User     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Payout {
  id          String    @id @default(uuid())
  partnerId   String
  amount      Float
  status      String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  requestedAt DateTime  @default(now())
  paidAt      DateTime?
  
  partner     User      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Announcement {
  id         String   @id @default(uuid())
  title      String
  content    String
  targetTier String   @default("ALL") // "ALL", "GOLD_ONLY", "SILVER_AND_UP"
  type       String   @default("Product Update")
  audience   String   @default("BOTH") // "PARTNER", "CUSTOMER", "BOTH"
  views      Int      @default(0)
  createdAt  DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FollowUpRule {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  delay     String   @default("24h")
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Feedback {
  id          String   @id @default(uuid())
  clientId    String?
  partnerId   String?
  type        String   // "bug", "feature", etc.
  title       String
  description String
  status      String   @default("Pending") // "Pending", "In Progress", "Resolved"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partner     User?    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model Integration {
  id        String   @id @default(uuid())
  clientId  String
  platform  String   // "LINE", "FACEBOOK", "INSTAGRAM", "TIKTOK", "YOUTUBE", "LAZADA", "WEBSITE"
  status    String   @default("ACTIVE") // "ACTIVE", "INACTIVE"
  config    Json     // Stores platform-specific tokens, pageIds, webhooks, or widget configs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform])
}

model Promotion {
  id          String   @id @default(uuid())
  partnerId   String
  code        String   @unique
  discount    Float    // percentage discount
  limit       Int      // max usage limit
  used        Int      @default(0) // current usage count
  createdAt   DateTime @default(now())

  partner     User     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model MarketingAsset {
  id        String   @id @default(uuid())
  filename  String
  category  String   // "Brand Assets", "Presentations", etc.
  url       String
  size      String   // e.g. "12.5 MB"
  downloads Int      @default(0)
  createdAt DateTime @default(now())
}
